{
  "entities": {
    "Campaign": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campaign",
      "type": "object",
      "description": "Represents a call campaign.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the campaign."
        },
        "name": {
          "type": "string",
          "description": "Name of the campaign."
        },
        "createdAt": {
          "type": "string",
          "description": "Date and time when the campaign was created.",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Donor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Donor",
      "type": "object",
      "description": "Represents a donor in a campaign.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Bloomerang Constituent ID."
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "address": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "skipped", "follow-up"]
        },
        "lastInteraction": {
          "type": ["object", "null"],
          "$ref": "#/entities/Interaction"
        },
        "givingSummary": {
          "$ref": "#/entities/GivingSummary"
        },
        "householdId": {
          "type": "string"
        },
        "householdName": {
          "type": "string"
        },
        "aiSummary": {
          "type": "string"
        }
      },
      "required": ["id", "name", "status"]
    },
    "Interaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Interaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "outcome": {
          "type": ["string", "null"],
          "enum": ["completed", "left-vm", "no-answer", "bad-number", null]
        },
        "notes": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        },
        "followUpDate": {
          "type": "string",
          "format": "date-time"
        },
        "loggedAt": {
          "type": "string",
          "format": "date-time"
        },
        "loggedBy": {
          "type": "string"
        }
      },
      "required": ["id", "notes", "loggedAt", "loggedBy"]
    },
    "GivingSummary": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GivingSummary",
      "type": "object",
      "properties": {
        "totalDonations": { "type": "number" },
        "lastDonationDate": { "type": ["string", "null"], "format": "date-time" },
        "lastDonationAmount": { "type": "number" },
        "averageGift": { "type": "number" }
      },
      "required": ["totalDonations", "lastDonationAmount", "averageGift"]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a follow-up task.",
      "properties": {
         "id": { "type": "string" },
         "donorId": { "type": "string" },
         "donorName": { "type": "string" },
         "campaignId": { "type": "string" },
         "campaignName": { "type": "string" },
         "subject": { "type": "string" },
         "dueDate": { "type": "string", "format": "date-time" },
         "status": { "type": "string", "enum": ["Active", "Complete"] },
         "channel": { "type": "string", "enum": ["Phone", "Email", "Other"] },
         "purpose": { "type": "string", "enum": ["FollowUp", "Other"] }
      },
      "required": ["donorId", "donorName", "campaignId", "subject", "dueDate", "status", "channel", "purpose"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/campaigns/{campaignId}",
        "definition": {
          "entityName": "Campaign",
          "schema": { "$ref": "#/entities/Campaign" },
          "description": "Stores user-created call campaigns. Each user can only access their own campaigns.",
          "params": [
            { "name": "userId", "description": "The ID of the user who owns the campaign." },
            { "name": "campaignId", "description": "The unique ID of the campaign." }
          ]
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/donors/{donorId}",
        "definition": {
          "entityName": "Donor",
          "schema": { "$ref": "#/entities/Donor" },
          "description": "Stores individual donors within a campaign. Authorization is inherited from the parent campaign.",
           "params": [
            { "name": "userId", "description": "The ID of the user." },
            { "name": "campaignId", "description": "The ID of the campaign." },
            { "name": "donorId", "description": "The unique ID of the donor." }
          ]
        }
      },
      {
        "path": "/users/{userId}/campaigns/{campaignId}/donors/{donorId}/interactions/{interactionId}",
        "definition": {
          "entityName": "Interaction",
          "schema": { "$ref": "#/entities/Interaction" },
          "description": "Logs interactions with donors. Authorization is inherited from the parent donor.",
           "params": [
            { "name": "userId", "description": "The ID of the user." },
            { "name": "campaignId", "description": "The ID of the campaign." },
            { "name": "donorId", "description": "The unique ID of the donor." },
            { "name": "interactionId", "description": "The unique ID of the interaction log." }
          ]
        }
      },
       {
        "path": "/users/{userId}/tasks/{taskId}",
        "definition": {
          "entityName": "Task",
          "schema": { "$ref": "#/entities/Task" },
          "description": "Stores user-specific follow-up tasks.",
           "params": [
            { "name": "userId", "description": "The ID of the user who owns the task." },
            { "name": "taskId", "description": "The unique ID of the task." }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed for user-specific data isolation. All data is nested under `/users/{userId}`, ensuring that security rules can easily enforce ownership. Campaigns are top-level documents under a user, and each campaign contains a subcollection of donors. Interactions and tasks are also stored logically."
  }
}
